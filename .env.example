# ============================================================
# TINA Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
# Use service role key for server-side operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Google Drive ────────────────────────────────────────────────────────────
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ─── Google Cloud Vision (OCR) ───────────────────────────────────────────────
GOOGLE_CLOUD_VISION_KEY=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
REQUEST_LIMIT=25mb
CORS_ORIGIN=*

# ─── Pipeline ────────────────────────────────────────────────────────────────
PIPELINE_LOG_ENABLED=true
MAX_CONVERSATION_TURNS=50
MAX_CONTEXT_TURNS=10

# ─── Langfuse Observability ───────────────────────────────────────────────────
# All three vars are required to enable tracing. Omit or set LANGFUSE_ENABLED=false
# to run in no-op mode (safe for local dev — TINA will still answer normally).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
