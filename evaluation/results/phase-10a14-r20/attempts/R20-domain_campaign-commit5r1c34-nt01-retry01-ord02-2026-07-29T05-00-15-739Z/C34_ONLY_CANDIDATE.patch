@@ -1311,6 +1311,26 @@ function resolveGovernedReasonOverride(evidence) {
   if (c33DirectRequestedTaxConsequence)
     return { decision: 'ALLOW', reasonCode: 'tax_treatment_of_ordinary_object', confidence: 0.89 };
 
+  const c34HasGovernedTaxRelation = v.rels.some((r) =>
+    r === 'ASKS_TAX_TREATMENT_OF' || r === 'ASKS_VAT_TREATMENT_OF'
+    || r === 'ASKS_DEDUCTIBILITY_OF' || r === 'ASKS_WITHHOLDING_ON'
