+const STRUCTURED_AUTHORITY_POSITION_FIELDS = Object.freeze([
+  "authorityPositionId",
+  "positionId",
+  "authorityVersionId",
+  "versionId",
+  "amendmentId",
+  "revisionId",
+  "effectiveFrom",
+  "effectiveTo",
+  "validFrom",
+  "validTo",
+  "supersedes",
+  "supersededBy"
+]);
+
+function normalizeAuthorityRecordValue(value = "") {
+  return lower(value)
+    .replace(/\\/g, "/")
+    .replace(/\s*\/\s*/g, "/")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+function getStructuredAuthorityPositionSignature(doc = {}) {
+  return STRUCTURED_AUTHORITY_POSITION_FIELDS
+    .map((field) => {
+      const value = doc[field] ?? doc.metadata?.[field];
+      const normalized = normalizeAuthorityRecordValue(value);
+      return normalized ? `${field}:${normalized}` : null;
+    })
+    .filter(Boolean)
+    .sort();
+}
+
+/**
+ * Chunk boundaries do not create independent legal positions. Two fragments
+ * from the same source and normalized legal reference are one authority
+ * record unless structured version/effectivity/supersession metadata
+ * identifies genuinely distinct positions.
+ */
+function distinctAuthorityPositionsGate(a = {}, b = {}) {
+  const sourceA = normalizeAuthorityRecordValue(getDocPath(a) || getDocSource(a));
+  const sourceB = normalizeAuthorityRecordValue(getDocPath(b) || getDocSource(b));
+  const referenceA = normalizeAuthorityRecordValue(
+    getDocNormalizedReference(a) || a.citation || a.statute || a.primaryStatute
+  );
+  const referenceB = normalizeAuthorityRecordValue(
+    getDocNormalizedReference(b) || b.citation || b.statute || b.primaryStatute
+  );
+
+  const sameAuthorityRecord =
+    Boolean(sourceA && sourceB && referenceA && referenceB) &&
+    sourceA === sourceB &&
+    referenceA === referenceB;
+
+  const positionA = getStructuredAuthorityPositionSignature(a);
+  const positionB = getStructuredAuthorityPositionSignature(b);
+  const structuredPositionDivergence =
+    positionA.length > 0 &&
+    positionB.length > 0 &&
+    positionA.join("|") !== positionB.join("|");
+  const passed = !sameAuthorityRecord || structuredPositionDivergence;
+
+  return {
+    passed,
+    sameAuthorityRecord,
+    structuredPositionDivergence,
+    sourceIdentity: sameAuthorityRecord ? sourceA : null,
+    referenceIdentity: sameAuthorityRecord ? referenceA : null,
+    sourceAPositionSignature: positionA,
+    sourceBPositionSignature: positionB,
+    reason: passed
+      ? sameAuthorityRecord
+        ? "Same authority record contains structured metadata identifying distinct legal positions."
+        : "Inputs are not the same normalized authority record."
+      : "Fragments of one authority record are not two identified legal positions."
+  };
+}
