    "defaultMaxRewriteTurns": 6,
    "hardMaxTurns": 20,
    "confidenceThreshold": 0.70,
    "defaultJurisdiction": "Philippines",
    "toleratedTurnShapes": ["{role,content}", "{sender,message}", "{type,text}"]
